---
/* A photography slot. Renders NOTHING until data/plates.json gives it a `src`.
   The empty-air treatment is the current design, not a placeholder — so a slot
   with no source contributes no box, no caption and no space.
   Adding a file to the manifest turns the photograph on with no layout change. */
import Tag from './Tag.astro';
import manifest from '../../data/plates.json';
interface Props { id: string; class?: string; eager?: boolean; }
const { id, class: cls = '', eager = false } = Astro.props;
const slot = manifest.slots.find((s) => s.id === id);
if (!slot) throw new Error(`Plate: no slot "${id}" in data/plates.json`);
const on = Boolean(slot.src);
---
{on && (
  <figure class={`plate plate--${slot.ratio} ${cls}`}>
    <div class="plate__box">
      <img src={slot.src} alt={slot.alt ?? slot.caption} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <figcaption class="cap"><Tag label={`${slot.caption}${slot.credit ? ` — ${slot.credit}` : ''}`} /></figcaption>
  </figure>
)}
