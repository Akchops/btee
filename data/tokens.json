{
  "colour": {
    "sheet":  { "hex": "#EAE6DB", "role": "warm paper — default ground, white-point clamp" },
    "ink":    { "hex": "#242720", "role": "everything drawn or written — black-point clamp" },
    "shade":  { "hex": "#333E34", "role": "the forest ground" },
    "night":  { "hex": "#0C1216", "role": "the sky, once" },
    "chik":   { "hex": "#B4644F", "role": "flower, lamp, and state — never text" }
  },
  "alpha": {
    "onSheet": { "body": 1.0, "secondary": 0.88, "caption": 0.82, "rail": 0.78, "hair": 0.2, "hairHover": 0.32 },
    "onShade": { "body": 1.0, "secondary": 0.86, "rail": 0.76, "hair": 0.2 },
    "onNight": { "display": 0.86, "body": 0.76, "rail": 0.68, "dim": 0.6, "hair": 0.2 }
  },
  "dapple": { "layerA": 0.025, "layerB": 0.015, "maxTotal": 0.04, "periodA": "120s", "periodB": "190s" },
  "ease": {
    "settle": "cubic-bezier(.16,.84,.30,1)",
    "lift":   "cubic-bezier(.32,.72,.24,1)",
    "drift":  "linear"
  },
  "grade": {
    "blackPoint": "#242720", "blackPointOnShade": "#2C352D", "whitePoint": "#EAE6DB",
    "cyanBand": [165, 200], "cyanChromaCut": 0.62, "cyanHueRotate": -8,
    "shadowWarmthTargetHue": 12.5, "shadowWarmthAmount": 0.06,
    "globalChroma": -0.15, "grain": 0.025
  }
}
